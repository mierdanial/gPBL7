# Copy this file to .env and fill in real values as needed.
# Everything works out of the box with NO .env file at all (full mock mode).

# --- Hardware mode ---
MOCK_HARDWARE_MODE=true
SESSION_DURATION_SECONDS=300
SAMPLE_INTERVAL_SECONDS=5

# --- LLM configuration ---
# Set MOCK_LLM_MODE=false and provide a real OpenRouter key to use a real
# model. Get a key at https://openrouter.ai/keys (one key gives access to
# many underlying models via the same OpenAI-compatible endpoint).
MOCK_LLM_MODE=true
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_HTTP_REFERER=http://localhost
LLM_APP_TITLE=Subway Surfers Fitness AI
LLM_MAX_TOKENS=2000
LLM_MAX_RETRIES=2

# --- MQTT configuration ---
MOCK_MQTT_MODE=true
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID=subway_fitness_ai

# --- Player / storage ---
DEFAULT_PLAYER_ID=P001

# General, non-medical safety threshold used only to trigger a cautious note.
HIGH_HEART_RATE_WARNING_BPM=160
